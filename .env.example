# Where enquiries are delivered. Leave empty to use the WhatsApp handoff only
# (the form then never claims the enquiry was saved).
# Receives a JSON POST; see lib/enquiry.ts for the payload.
LEAD_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <token>" to the destination.
LEAD_WEBHOOK_TOKEN=
# Public site URL (https, no trailing slash), used for canonical, Open Graph and sitemap URLs.
# REQUIRED on a Vercel production deployment: the build fails without it.
NEXT_PUBLIC_SITE_URL=
# Set to "true" on a non-Vercel production host so search engines may index the page.
# On Vercel production this is automatic; previews and staging stay noindex.
ALLOW_INDEXING=
